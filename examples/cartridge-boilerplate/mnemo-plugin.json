{
  "name": "@mnemosyne-plugins/boilerplate",
  "displayName": "Cartridge Boilerplate",
  "version": "1.0.0",
  "description": "Standard template for Mnemosyne OS Cartridges",
  "permissions": [
    "vault:read",
    "vault:write",
    "model:infer",
    "dialog:open",
    "gesture:receive"
  ],
  "gestures": {
    "takes": [
      "orbit",
      "depth",
      "recenter",
      "point",
      "select",
      "next",
      "prev"
    ],
    "actions": [
      {
        "id": "explode",
        "label": {
          "en": "Exploded view",
          "fr": "Vue éclatée",
          "es": "Vista despiezada"
        }
      }
    ]
  },
  "updateStrategy": "git",
  "entrypoints": {
    "renderer": "http://localhost:5185/index.html"
  },
  "widgets": [
    {
      "id": "boilerplate-main",
      "icon": "🧩",
      "name": "Boilerplate Widget",
      "route": "index.html",
      "defaultWidth": 500,
      "defaultHeight": 600
    }
  ]
}
