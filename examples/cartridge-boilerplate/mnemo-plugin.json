{
  "name": "@mnemosyne-plugins/boilerplate",
  "displayName": "Cartridge Boilerplate",
  "version": "1.0.0",
  "icon": "icon.svg",
  "description": "Standard template for Mnemosyne OS Cartridges",
  "permissions": [
    "vault:read",
    "vault:write",
    "model:infer",
    "dialog:open",
    "gesture:receive"
  ],
  "gestures": {
    "takes": [
      "orbit",
      "depth",
      "recenter",
      "point",
      "select",
      "next",
      "prev"
    ],
    "actions": [
      {
        "id": "explode",
        "label": {
          "en": "Exploded view",
          "fr": "Vue éclatée",
          "es": "Vista despiezada"
        }
      }
    ]
  },
  "agentActions": [
    {
      "id": "notes",
      "summary": "List the notes saved in this cartridge's sandbox vault",
      "effect": "read"
    },
    {
      "id": "addNote",
      "summary": "Save one note in this cartridge's sandbox vault, as the Remember button does",
      "effect": "write",
      "params": {
        "text": {
          "type": "string",
          "description": "The note to save",
          "maxLength": 2000
        }
      },
      "required": ["text"]
    }
  ],
  "agentGuide": [
    "Call notes first: addNote does not check for duplicates.",
    "Both actions answer an error while the sandbox vault is not ready; call again a few seconds later."
  ],
  "updateStrategy": "git",
  "entrypoints": {
    "renderer": "http://localhost:5185/index.html"
  },
  "widgets": [
    {
      "id": "boilerplate-main",
      "icon": "🧩",
      "name": "Boilerplate Widget",
      "route": "index.html",
      "defaultWidth": 500,
      "defaultHeight": 600
    }
  ]
}
