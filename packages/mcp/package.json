{
  "name": "@mnemosyne_os/mcp",
  "version": "1.10.0",
  "mcpName": "io.github.Mnemosyne-OS/mcp",
  "description": "MCP server for Mnemosyne OS — gives AI agents access to vault memory, resonances, git context, and to what the OTHER coding agents on this machine are doing.",
  "keywords": [
    "mnemosyne",
    "mcp",
    "model-context-protocol",
    "ai",
    "memory",
    "local-ai",
    "sovereign",
    "layer2",
    "agent-awareness",
    "transcripts",
    "observability"
  ],
  "author": {
    "name": "Tony Trochet",
    "email": "tony@xpacegems.com",
    "url": "https://www.linkedin.com/in/tony-t-19544650/"
  },
  "license": "MIT",
  "homepage": "https://mnemosyne-os.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "mnemosyne-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/*.test.ts\"",
    "start": "node dist/index.js",
    "release": "npm run typecheck && npm run build:publish && npm publish --access public",
    "build:publish": "tsup src/index.ts --format esm --clean",
    "prepublishOnly": "npm run typecheck && npm run build:publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "@mnemosyne_os/agent-transcripts": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
