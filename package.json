{
  "name": "mnemosyne-os-ecosystem",
  "version": "0.0.0",
  "private": true,
  "description": "Mnemosyne OS — open developer ecosystem (SDK, CLI, examples)",
  "license": "MIT",
  "homepage": "https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS.git"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "check:sync": "node tools/check-public-sync.mjs"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7 <5.0.0",
      "brace-expansion": ">=2.1.7 <3.0.0",
      "tsup>esbuild": ">=0.28.1 <0.29.0",
      "undici": ">=7.29.1 <8.0.0",
      "fast-uri": ">=3.1.8 <4.0.0",
      "ip-address": ">=10.7.1 <11.0.0",
      "@modelcontextprotocol/sdk": ">=1.31.0 <2.0.0",
      "proxy-addr": ">=2.0.8 <3.0.0",
      "source-map-js": ">=1.2.2 <2.0.0"
    }
  }
}
