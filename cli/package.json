{
  "name": "@mnemosyne_os/forge",
  "version": "1.4.7",
  "description": "MnemoForge CLI - The AI Inception Engine for the Mnemosyne Neural OS ecosystem. Scaffold sovereign, AI-governed modules in one command.",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "dist/cli.js",
  "bin": {
    "mnemoforge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc -w",
    "test": "tsx --test src/__tests__/chronicle-parser.test.ts src/__tests__/renderer.test.ts src/__tests__/resonance.test.ts",
    "test:watch": "tsx --test --watch src/__tests__/chronicle-parser.test.ts src/__tests__/renderer.test.ts src/__tests__/resonance.test.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mnemosyne", "cli", "scaffold", "ai", "agent", "mnemoforge",
    "liquid-glass", "react", "tailwind", "cursor", "sovereign-ai",
    "code-generator", "boilerplate", "chronicle", "neural-coding"
  ],
  "author": {
    "name": "Tony Trochet",
    "email": "tony@xpacegems.com",
    "url": "https://www.linkedin.com/in/tony-t-19544650/"
  },
  "license": "MIT",
  "homepage": "https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS",
  "repository": { "type": "git", "url": "https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS.git" },
  "bugs": { "url": "https://github.com/Mnemosyne-OS/Mnemosyne-Neural-OS/issues" },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}